# Copier ce fichier en .env puis compléter (le fichier .env n'est jamais versionné)

# Projet Google Cloud et zone de stockage
GCP_PROJECT_ID=mon-projet-damir
GCS_BUCKET=mon-projet-damir-landing
BQ_LOCATION=EU
BQ_RAW_DATASET=damir_raw
BQ_RAW_TABLE=prestations

# Modèle d'URL des fichiers mensuels ({yyyymm}, {year} et {month} sont remplacés).
# À vérifier sur la page Ameli « Open Damir : base complète » : clic droit sur le
# lien d'un mois > Copier l'adresse du lien.
DAMIR_URL_TEMPLATE=https://open-data-assurance-maladie.ameli.fr/depenses/download_file.php?file=Open_DAMIR/A{yyyymm}.csv.gz

# Dossier local des fichiers téléchargés et convertis
DATA_DIR=data

# Linux uniquement : votre identifiant utilisateur (commande : id -u), pour que
# le conteneur Airflow puisse écrire dans les dossiers montés
AIRFLOW_UID=50000
